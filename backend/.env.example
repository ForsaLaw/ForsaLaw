# Copier vers .env (non versionne) et renseigner les valeurs. Charger les variables dans l'IDE ou Docker.

# OBLIGATOIRES (fail-fast) : sans DB_USERNAME, DB_PASSWORD et JWT_SECRET, l'application refuse de demarrer.
DB_URL=jdbc:postgresql://localhost:5433/forsalaw
DB_USERNAME=forsalaw
DB_PASSWORD=forsalaw

# OBLIGATOIRE : cle longue et aleatoire, >= 32 caracteres (aucune valeur par defaut cote application).
JWT_SECRET=replace_with_a_strong_secret_min_32_chars
JWT_EXPIRATION_MS=86400000

GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
# URL du front (Vite) après login Google — pas la doc Swagger ni l’URL de l’API seule
OAUTH2_SUCCESS_REDIRECT_URI=http://localhost:3000/auth/google/callback

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_smtp_username
MAIL_PASSWORD=your_smtp_password_or_app_password
MAIL_FROM=no-reply@forsalaw.com

# Reset mot de passe : base URL de la page /reset-password?token=... (besoin du frontend ; defaut 4200)
PASSWORD_RESET_FRONTEND_URL=http://localhost:4200/reset-password

# Notifications RDV : lien generique dans le mail (sans frontend : Swagger sur le port de l'API)
FRONTEND_BASE_URL=http://localhost:8081/swagger-ui.html

# Visio RDV en ligne (gratuit) : Jitsi public
JITSI_BASE_URL=https://meet.jit.si

# Email admin recevant les demandes de deblocage de compte
ADMIN_SUPPORT_EMAIL=admin@forsalaw.com

# Rappels RDV J-1 / H-1 (identifiant fuseau IANA)
NOTIFICATIONS_TIMEZONE=Africa/Tunis

# CORS : origines frontend autorisees (liste separee par des virgules). Surcharger en production.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# WhatsApp bridge : secret partage (>= 16 caracteres). Doit etre IDENTIQUE cote bridge Node.js
# (variable d'environnement WHATSAPP_BRIDGE_TOKEN au lancement de bridge.js). Le bridge refuse
# de demarrer sans, et rejette (401) toute requete sans en-tete Authorization: Bearer <token>.
WHATSAPP_BRIDGE_TOKEN=replace_with_a_shared_bridge_secret

# Optionnel
SERVER_PORT=8081
