# ============================================================================
# ForsaLaw — variables d'environnement (backend)
# Copier ce fichier vers backend/.env (NON versionne) et renseigner les valeurs.
# Charger les variables via l'IDE, un fichier .env, ou l'environnement Docker/CI.
# ============================================================================

# ─── OBLIGATOIRES ───────────────────────────────────────────────────────────
# Sans ces variables, l'application refuse de demarrer (fail-fast) ou une
# fonctionnalite critique est desactivee.

# Base de donnees PostgreSQL (aligne sur backend/docker-compose.yml en local).
DB_URL=jdbc:postgresql://localhost:5433/forsalaw_rag
DB_USERNAME=forsalaw
DB_PASSWORD=forsalaw

# Secret de signature JWT — cle longue et aleatoire, >= 32 caracteres. AUCUN defaut.
JWT_SECRET=replace_with_a_strong_secret_min_32_chars

# Bridge WhatsApp (Node.js) — secret partage, >= 16 caracteres. Doit etre IDENTIQUE
# cote bridge (variable WHATSAPP_BRIDGE_TOKEN au lancement de bridge.js). Le bridge
# refuse de demarrer sans, et rejette (401) toute requete sans Authorization: Bearer.
WHATSAPP_BRIDGE_TOKEN=replace_with_a_shared_bridge_secret

# SMTP — envoi d'e-mails (reset mot de passe, notifications RDV). Sans ces deux
# variables, l'envoi d'e-mails est desactive (les liens ne partiront pas).
MAIL_USERNAME=your_smtp_username
MAIL_PASSWORD=your_smtp_password_or_app_password

# ─── CONFIGURABLES (un defaut existe, surcharger selon l'environnement) ──────

# CORS : origines frontend autorisees (liste separee par des virgules).
# Mappe la propriete forsalaw.cors.allowed-origins.
FORSALAW_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Strategie de schema Hibernate : "update" en developpement,
# "validate" en production (apres verification du baseline Flyway contre une vraie base).
JPA_DDL_AUTO=update

# Stockage objet (coffre-fort documentaire) — remplace l'ecriture sur disque local.
# Les valeurs ci-dessous ciblent le MinIO de backend/docker-compose.yml.
# En production AWS : laisser S3_ENDPOINT vide, mettre S3_PATH_STYLE=false, et NE PAS
# renseigner S3_ACCESS_KEY / S3_SECRET_KEY (le role IAM de l'instance est utilise).
# Le bucket doit exister au prealable : l'application ne le cree pas.
S3_BUCKET=forsalaw-documents
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
S3_PATH_STYLE=true
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Broker STOMP externe (RabbitMQ) pour la messagerie temps reel.
# Laisser false en mono-instance : le broker en memoire suffit et aucun RabbitMQ n'est requis.
# Passer a true des qu'il y a PLUSIEURS instances, sinon un message publie par l'instance A
# n'atteint pas un client connecte a l'instance B.
# Les valeurs ci-dessous ciblent le RabbitMQ de backend/docker-compose.yml.
WS_BROKER_RELAY_ENABLED=false
WS_BROKER_HOST=localhost
WS_BROKER_PORT=61613
WS_BROKER_VHOST=/
WS_BROKER_USER=forsalaw
WS_BROKER_PASSWORD=forsalaw
WS_BROKER_SYSTEM_USER=forsalaw
WS_BROKER_SYSTEM_PASSWORD=forsalaw

# ─── OPTIONNELLES ───────────────────────────────────────────────────────────

JWT_EXPIRATION_MS=86400000

# OAuth2 Google (connexion avec Google).
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
# URL du front (Vite) apres login Google — pas la doc Swagger ni l'URL de l'API seule.
OAUTH2_SUCCESS_REDIRECT_URI=http://localhost:3000/auth/google/callback

# SMTP — hote / port / expediteur (defauts Gmail).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_FROM=no-reply@forsalaw.com

# Liens dans les e-mails.
PASSWORD_RESET_FRONTEND_URL=http://localhost:4200/reset-password
FRONTEND_BASE_URL=http://localhost:8081/swagger-ui.html

# Visio RDV en ligne (gratuit) : Jitsi public.
JITSI_BASE_URL=https://meet.jit.si

# Email admin recevant les demandes de deblocage de compte.
ADMIN_SUPPORT_EMAIL=admin@forsalaw.com

# Amorcage du premier compte ADMIN (AdminSeeder). Definir les DEUX pour creer un admin au
# demarrage si aucun n'existe. Laisser vide sinon (aucun seed, simple avertissement au log).
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

# Rappels RDV J-1 / H-1 (identifiant fuseau IANA).
NOTIFICATIONS_TIMEZONE=Africa/Tunis

# Port du serveur.
SERVER_PORT=8081
