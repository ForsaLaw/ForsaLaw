# ============================================================================
# Variables de docker-compose.prod.yml
#   cp .env.prod.example .env    puis renseigner les valeurs
#
# Compose lit automatiquement le fichier .env situe a cote de docker-compose.prod.yml.
# Les variables marquees OBLIGATOIRE font echouer `docker compose up` si elles manquent.
# Pour la liste exhaustive des reglages du backend, voir backend/.env.example.
# ============================================================================

# ─── OBLIGATOIRE ────────────────────────────────────────────────────────────

# URL publique du site, telle que vue par le navigateur. Sert aussi a construire les liens
# des e-mails et la redirection OAuth2 : une valeur erronee envoie des liens inutilisables
# aux utilisateurs.
PUBLIC_BASE_URL=https://app.forsalaw.tn

# Domaine servi en HTTPS par le terminaisseur TLS (service « proxy », Caddy). Doit resoudre en
# DNS vers cette machine, ports 80 et 443 joignables depuis l'exterieur : Let's Encrypt valide
# la possession du domaine en appelant le port 80. Un nom qui ne resout pas, ou un port 80
# ferme, fait echouer l'emission — le site reste alors en HTTP et, AUTH_COOKIE_SECURE valant
# true, plus personne ne peut se connecter.
# Sans schema ni chemin : le nom d'hote seul, coherent avec PUBLIC_BASE_URL ci-dessus.
PUBLIC_DOMAIN=app.forsalaw.tn

# Base de donnees.
DB_USERNAME=forsalaw
DB_PASSWORD=change_me_strong_password

# Signature des JWT — chaine aleatoire d'au moins 32 caracteres.
JWT_SECRET=change_me_random_min_32_characters_long

# Stockage objet (MinIO). Sert a la fois d'identifiants MinIO et de credentials S3 du backend.
S3_ACCESS_KEY=change_me_minio_user
S3_SECRET_KEY=change_me_minio_password

# Broker STOMP (RabbitMQ). Utilisateur dedie : "guest" est refuse hors loopback.
WS_BROKER_USER=forsalaw
WS_BROKER_PASSWORD=change_me_rabbitmq_password

# ─── FACULTATIF (des defauts existent) ──────────────────────────────────────

DB_NAME=forsalaw
S3_BUCKET=forsalaw-documents
S3_REGION=us-east-1

# Adresse prevenue par Let's Encrypt si un renouvellement echoue. Vivement conseillee : sans
# elle, un certificat qui cesse de se renouveler n'alerte personne avant l'expiration.
ACME_EMAIL=admin@forsalaw.tn

# FRONTEND_PORT n'est plus utilise : le frontend ne publie plus de port sur l'hote. Seul le
# service « proxy » expose 80 et 443, pour qu'aucun acces en clair ne contourne HTTPS.

# Mettre a false uniquement si le site est servi en HTTP simple : en HTTPS, un cookie
# non "Secure" est ignore par le navigateur et plus personne ne peut se connecter.
AUTH_COOKIE_SECURE=true

# Hibernate : le schema est gere par Flyway, "validate" est le reglage attendu en production.
JPA_DDL_AUTO=validate

# Vectorisation RAG (bge-m3 auto-heberge via Text Embeddings Inference).
# Image CPU par defaut ; pour ingerer un corpus complet, utiliser une image GPU et
# declarer les ressources correspondantes dans docker-compose.prod.yml.
# 1.7 minimum : la 1.5 ne sait pas telecharger bge-m3 (« relative URL without a base »).
EMBEDDING_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-1.7
EMBEDDING_MODEL=BAAI/bge-m3

# Taille du lot de vectorisation. Trop haut = conteneur tue par le noyau (OOMKilled) au
# demarrage, sans message, en boucle -- et le backend, qui attend « embeddings » en bonne
# sante, ne demarre jamais. 2048 tient dans 8 Go de RAM. Ne relever qu'apres mesure.
EMBEDDING_MAX_BATCH_TOKENS=2048
# Plafond de validation des requetes, sans effet sur la memoire. Doit rester >= a
# forsalaw.rag.embedding.batch-size cote backend (16), sinon TEI renvoie HTTP 413.
EMBEDDING_MAX_CLIENT_BATCH=32

# Reformulation HyDE avant vectorisation (HydeQueryRewriter), auto-hebergee (Ollama) pour la
# meme raison que bge-m3 : une question de recherche peut porter sur un fait confidentiel.
# HYDE_ENABLED=false bascule sur la question brute systematique (aucune recherche n'echoue
# jamais faute de ce service). Modele 3B et non 7B : sur un GPU de 6 Go, TEI en occupe deja
# ~1,5 Go, un 7B serait trop proche du plafond ayant cause l'OOM d'embeddings.
HYDE_ENABLED=true
HYDE_MODEL=qwen2.5:3b-instruct
HYDE_TIMEOUT_SECONDS=8

# Collecte JORT : n'activer que sur UNE SEULE instance, et seulement apres avoir calibre
# les selecteurs CSS contre le site reel (voir JortHtmlParser). iort.gov.tn est un service
# public : activer cette tache partout reviendrait a le solliciter depuis chaque replica.
JORT_ENABLED=false

# OAuth2 Google (laisser vide pour desactiver la connexion Google).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMTP (laisser vide pour desactiver l'envoi d'e-mails).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@forsalaw.com

# Bridge WhatsApp (secret partage avec bridge.js).
WHATSAPP_BRIDGE_TOKEN=

# Amorcage du premier compte administrateur (les DEUX ou aucun).
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
